    },
    {
      "from": "archive",
      "to": "archive",
      "condition": "pause"
    }
  ],
  "outputSchemas": [
    {
      "id": "yt.clarify.v1",
      "description": "需求澄清纪要（决策树与逐轮问答）",
      "artifacts": [
        {
          "id": "clarify-log",
          "kind": "file",
          "required": true,
          "paths": [
            "docs/sy-comet/current/clarify-log.md"
          ],
          "pathBase": "project",
          "validations": [
            "artifact-exists"
          ]
        }
      ],
      "evidence": [
        {
          "id": "clarify-summary",
          "required": true
        }
      ]
    },
    {
      "id": "yt.specify.v1",
      "description": "PRD（目标/范围/用户故事/验收标准）与 ADR（上下文/选项/结论/理由）",
      "artifacts": [
        {
          "id": "prd",
          "kind": "file",
          "required": true,
          "paths": [
            "docs/sy-comet/current/prd.md"
          ],
          "pathBase": "project",
          "validations": [
            "artifact-exists"
          ]
        },
        {
          "id": "adr",
          "kind": "file",
          "required": true,
          "paths": [
            "docs/sy-comet/current/adr.md"
          ],
          "pathBase": "project",
          "validations": [
            "artifact-exists"
          ]
        },
        {
          "id": "spec-delta",
          "kind": "file",
          "required": true,
          "paths": [
            "docs/sy-comet/current/spec-delta.md"
          ],
          "pathBase": "project",
          "validations": [
            "artifact-exists"
          ]
        }
      ],
      "evidence": [
        {
          "id": "spec-summary",
          "required": true
        }
      ]
    },
    {
      "id": "yt.design.v1",
      "description": "基于 PRD 的详细设计（架构/数据流/错误处理/测试策略）",
      "artifacts": [
        {
          "id": "design-doc",
          "kind": "file",
          "required": true,
          "paths": [
            "docs/sy-comet/current/design.md"
          ],
          "pathBase": "project",
          "validations": [
            "artifact-exists"
          ]
        }
      ],
      "evidence": [
        {
          "id": "design-summary",
          "required": true
        }
      ]
    },
    {
      "id": "yt.plan.v1",
      "description": "轻量任务与验证记录，无强制 commit 字段",
      "artifacts": [
        {
          "id": "plan-doc",
          "kind": "file",
          "required": true,
          "paths": [
            "docs/sy-comet/current/plan.md"
          ],
          "pathBase": "project",
          "validations": [
            "artifact-structured"
          ]
        },
        {
          "id": "tasks",
          "kind": "file",
          "required": true,
