{
  "schemaVersion": 2,
  "kind": "workflow-kernel",
  "name": "sy-comet",
  "goal": "轻量研发：grill-me 澄清 → PRD/增量 Spec → UI → 技术设计 → 轻量任务 → 可恢复执行 → 测试报告 → 验收与 Spec 归档；可分发安装包自动补齐依赖。",
  "comment": "本文件只保留 scripts/yt.mjs 运行时真实消费的字段；节点顺序即推进顺序。门禁/校验逻辑硬编码于 yt.mjs（确认节点见各节点 approval，验证-修复上限 3 次）。编辑本文件会改变 protocolHash，进行中变更需运行 yt.mjs migrate。",
  "config": {
    "specTargetPrefix": "openspec/specs/",
    "specSyncRequired": true,
    "maxVerifyFailures": 3,
    "requirementIdPattern": "REQ-\\d+",
    "requireCoverage": true
  },
  "uiSkillRouting": {
    "comment": "UI 节点按场景选择设计 Skill，而非硬编码单一依赖。primary 为该场景的主 Skill，supports 为可选叠加。分发包含 primary/supports 里 required:true 的 Skill；required:false 的缺失时只在 ui.md 记录实际使用情况，不阻断。",
    "scenarios": [
      {
        "id": "admin",
        "label": "政务/企业后台、多角色权限、含审批流的管理系统",
        "when": "需求含多角色权限分化、审批流、或管理后台（列表/表单/看板）形态",
        "primary": "sy-hifi-prototype",
        "supports": ["ui-ux-pro-max"],
        "note": "sy-hifi-prototype 自带角色权限矩阵、五态、浏览器实测与交付审计，与 UI 节点门禁同构；它不是本包分发内容，缺失时改用 fallback。"
      },
      {
        "id": "brand",
        "label": "已有公司/品牌设计规范的项目",
        "when": "项目存在强制品牌规范（自带 design tokens 的 Skill，如 sy-frontend-design）",
        "primary": "sy-frontend-design",
        "supports": [],
        "note": "品牌一致性优先于审美独特性：此时不使用 frontend-design 的『追求独特方向』取向。"
      },
      {
        "id": "marketing",
        "label": "C 端页面、落地页、营销页、展示型站点",
        "when": "面向外部用户、以传达与转化为目标、无复杂角色权限",
        "primary": "frontend-design",
        "supports": ["ui-ux-pro-max"],
        "note": "本包内置 frontend-design（Anthropic 官方，Apache-2.0），无需额外安装。"
      }
    ],
    "fallback": "frontend-design",
    "fallbackNote": "无法判断场景或上述主 Skill 不可用时，用内置 frontend-design 兜底；仍须在 ui.md 记录五态与实测结论。"
  },
  "nodes": [
    {
      "id": "clarify",
      "label": "需求澄清：澄清范围、关键业务决定和验收条件，产物为澄清纪要",
      "approval": true,
      "outputSchemas": ["yt.clarify.v1"]
    },
    {
      "id": "specify",
      "label": "整理 PRD 与 ADR",
      "approval": true,
      "outputSchemas": ["yt.specify.v1"]
    },
    {
      "id": "ui",
      "label": "UI 设计；无界面需求时 skip",
      "skippable": true,
      "approval": true,
      "outputSchemas": ["yt.ui.v1"]
    },
    {
      "id": "design",
      "label": "详细设计；小型变更（无架构调整/数据迁移/新接口）可 skip",
      "skippable": true,
      "approval": true,
      "outputSchemas": ["yt.design.v1"]
    },
    {
      "id": "plan",
      "label": "可续跑执行计划",
      "outputSchemas": ["yt.plan.v1"]
    },
    {
      "id": "execute",
      "label": "逐任务执行",
      "outputSchemas": ["yt.execute.v1"]
    },
    {
      "id": "verify",
      "label": "测试并输出报告",
      "outputSchemas": ["yt.verify.v1"]
    },
    {
      "id": "archive",
      "label": "验收与 Spec 归档",
      "approval": true,
      "outputSchemas": ["yt.archive.v1"]
    }
  ],
  "outputSchemas": [
    {
      "id": "yt.clarify.v1",
      "artifacts": [
        { "required": true, "paths": ["docs/sy-comet/current/clarify-log.md"] }
      ]
    },
    {
      "id": "yt.specify.v1",
      "artifacts": [
        { "required": true, "paths": ["docs/sy-comet/current/prd.md"] },
        { "required": true, "paths": ["docs/sy-comet/current/adr.md"] },
        { "required": true, "paths": ["docs/sy-comet/current/spec-delta.md"] }
      ]
    },
    {
      "id": "yt.ui.v1",
      "artifacts": [
        { "required": true, "paths": ["docs/sy-comet/current/ui.md"] }
      ]
    },
    {
      "id": "yt.design.v1",
      "artifacts": [
        { "required": true, "paths": ["docs/sy-comet/current/design.md"] }
      ]
    },
    {
      "id": "yt.plan.v1",
      "artifacts": [
        { "required": true, "paths": ["docs/sy-comet/current/plan.md"] },
        { "required": true, "paths": ["docs/sy-comet/current/tasks.json"] }
      ]
    },
    {
      "id": "yt.execute.v1",
      "artifacts": [
        { "required": true, "paths": ["docs/sy-comet/current/plan.md"] }
      ]
    },
    {
      "id": "yt.verify.v1",
      "artifacts": [
        { "required": true, "paths": ["docs/sy-comet/current/test-report.md"] },
        { "required": true, "paths": ["docs/sy-comet/current/test-results.json"] }
      ]
    },
    {
      "id": "yt.archive.v1",
      "artifacts": [
        { "required": true, "paths": ["docs/sy-comet/current/archive-report.md"] },
        { "required": true, "paths": ["docs/sy-comet/current/spec-sync.json"] }
      ]
    }
  ],
  "state": {
    "kind": "workflow-run",
    "statePath": ".comet/runs/sy-comet/state.json",
    "currentNodeField": "currentNode",
    "completedNodesField": "completedNodes",
    "evidenceField": "evidence"
  }
}
