{
  "schemaVersion": 2,
  "kind": "workflow-kernel",
  "name": "t-flow",
  "goal": "轻量研发：grill-me 澄清 → PRD/增量 Spec → UI → 技术设计 → 轻量任务 → 可恢复执行 → 测试报告 → 验收与 Spec 归档；可分发安装包自动补齐依赖。",
  "comment": "本文件只保留 scripts/yt.mjs 运行时真实消费的字段；节点顺序即推进顺序。门禁/校验逻辑硬编码于 yt.mjs（确认节点见各节点 approval，验证-修复上限 3 次）。编辑本文件会改变 protocolHash，进行中变更需运行 yt.mjs migrate。",
  "config": {
    "specTargetPrefix": "openspec/specs/",
    "specSyncRequired": true,
    "maxVerifyFailures": 3,
    "requirementIdPattern": "REQ-\\d+",
    "requireCoverage": true
  },
  "uiSkillRouting": {
    "comment": "UI 节点使用的设计 Skill。二者都随本包分发（skills/ 下），本地缺失时由 install/ensure-skills 自动补齐到项目 .agents/skills/ 并链接到 .claude/skills/。primary 为主 Skill，fallback 仅在其不可用时兜底。",
    "primary": "ui-ux-pro-max",
    "fallback": "frontend-design",
    "distribution": [
      "ui-ux-pro-max",
      "frontend-design"
    ],
    "primaryNote": "ui-ux-pro-max 覆盖 79 风格/50 启用、192 产品配色与推理、74 字体配对、119 条 UX 准则、105 图标、17 GSAP 预设、25 图表类型、22 技术栈，含无障碍硬指标（对比度 4.5:1、44×44 触控目标、键盘导航），适用于后台、C 端、移动端与桌面端全部含界面场景。检索脚本 scripts/search.py 需 Python 3，无外部依赖。",
    "fallbackNote": "frontend-design（Anthropic 官方，Apache-2.0）为纯审美指导，不覆盖五态与角色权限；仅在 ui-ux-pro-max 不可用时兜底，此时须自行补齐五态并在 ui.md 说明。",
    "fiveStatesRequired": true,
    "fiveStatesNote": "无论用哪个 Skill，空/加载/错误/无权限/正常五态与浏览器实测结论都必须写入 ui.md——这是本节点的硬要求，不因所选 Skill 而豁免。",
    "source": "https://github.com/nextlevelbuilder/ui-ux-pro-max-skill",
    "license": "MIT"
  },
  "uiChange": {
    "comment": "存量项目 UI 变更的绑定与检查。scopes 声明本次改动类型；styleGlobs 是样式层文件模式——UI 变更的证据若完全没绑定到这些模式，视觉改动不会被检出，run 会告警。affectedPrefixes 用于识别'改动落在既有界面目录'。",
    "styleGlobs": [
      "**/*.css", "**/*.scss", "**/*.sass", "**/*.less", "**/*.styl",
      "**/*.stylus", "**/*.pcss", "**/*.postcss",
      "**/tailwind.config.*", "**/postcss.config.*", "**/vite.config.*", "**/webpack.config.*",
      "**/theme*.{js,ts,json,jsx,tsx}", "**/tokens*.{js,ts,json,jsx,tsx}",
      "**/design-tokens*", "**/variables*.{css,scss,less}",
      "**/*.module.{css,scss,less}", "**/styled-components/**", "**/emotion*"
    ],
    "styleWarnEnabled": true,
    "styleWarnNote": "UI 变更（ui 节点有产物）时，若证据输入未匹配任何 styleGlobs，说明样式/主题改动不会被'证据过期'检出——run 会打印 WARN。多数情况下应把样式目录或主题文件加入任务 modules 或 --input。",
    "declareBlock": "ui-scope",
    "declareNote": "ui.md 中的 ui-scope 代码块是机器可读的界面声明（YAML 子集），把'用户确认的界面'与真实文件绑定：mode 为 new（新建）或 change（存量改造）；files 列出本次交付/改动的界面文件或目录；affected 列出受影响的既有界面（改造时必填）。check 会校验这些路径真实存在，并把 files 强制计入证据输入，使'确认的界面 ≠ 交付的界面'无法通过。"
  },
  "nodes": [
    {
      "id": "clarify",
      "label": "需求澄清：澄清范围、关键业务决定和验收条件，产物为澄清纪要",
      "approval": true,
      "outputSchemas": [
        "yt.clarify.v1"
      ]
    },
    {
      "id": "specify",
      "label": "整理 PRD 与 ADR",
      "approval": true,
      "outputSchemas": [
        "yt.specify.v1"
      ]
    },
    {
      "id": "ui",
      "label": "UI 设计；无界面需求时 skip",
      "skippable": true,
      "approval": true,
      "outputSchemas": [
        "yt.ui.v1"
      ]
    },
    {
      "id": "design",
      "label": "详细设计；小型变更（无架构调整/数据迁移/新接口）可 skip",
      "skippable": true,
      "approval": true,
      "outputSchemas": [
        "yt.design.v1"
      ]
    },
    {
      "id": "plan",
      "label": "可续跑执行计划",
      "outputSchemas": [
        "yt.plan.v1"
      ]
    },
    {
      "id": "execute",
      "label": "逐任务执行",
      "outputSchemas": [
        "yt.execute.v1"
      ]
    },
    {
      "id": "verify",
      "label": "测试并输出报告",
      "outputSchemas": [
        "yt.verify.v1"
      ]
    },
    {
      "id": "archive",
      "label": "验收与 Spec 归档",
      "approval": true,
      "outputSchemas": [
        "yt.archive.v1"
      ]
    }
  ],
  "outputSchemas": [
    {
      "id": "yt.clarify.v1",
      "artifacts": [
        {
          "required": true,
          "paths": [
            "docs/t-flow/current/clarify-log.md"
          ]
        }
      ]
    },
    {
      "id": "yt.specify.v1",
      "artifacts": [
        {
          "required": true,
          "paths": [
            "docs/t-flow/current/prd.md"
          ]
        },
        {
          "required": true,
          "paths": [
            "docs/t-flow/current/adr.md"
          ]
        },
        {
          "required": true,
          "paths": [
            "docs/t-flow/current/spec-delta.md"
          ]
        }
      ]
    },
    {
      "id": "yt.ui.v1",
      "artifacts": [
        {
          "required": true,
          "paths": [
            "docs/t-flow/current/ui.md"
          ]
        }
      ]
    },
    {
      "id": "yt.design.v1",
      "artifacts": [
        {
          "required": true,
          "paths": [
            "docs/t-flow/current/design.md"
          ]
        }
      ]
    },
    {
      "id": "yt.plan.v1",
      "artifacts": [
        {
          "required": true,
          "paths": [
            "docs/t-flow/current/plan.md"
          ]
        },
        {
          "required": true,
          "paths": [
            "docs/t-flow/current/tasks.json"
          ]
        }
      ]
    },
    {
      "id": "yt.execute.v1",
      "artifacts": [
        {
          "required": true,
          "paths": [
            "docs/t-flow/current/plan.md"
          ]
        }
      ]
    },
    {
      "id": "yt.verify.v1",
      "artifacts": [
        {
          "required": true,
          "paths": [
            "docs/t-flow/current/test-report.md"
          ]
        },
        {
          "required": true,
          "paths": [
            "docs/t-flow/current/test-results.json"
          ]
        }
      ]
    },
    {
      "id": "yt.archive.v1",
      "artifacts": [
        {
          "required": true,
          "paths": [
            "docs/t-flow/current/archive-report.md"
          ]
        },
        {
          "required": true,
          "paths": [
            "docs/t-flow/current/spec-sync.json"
          ]
        }
      ]
    }
  ],
  "state": {
    "kind": "workflow-run",
    "statePath": ".t-flow/runs/t-flow/state.json",
    "currentNodeField": "currentNode",
    "completedNodesField": "completedNodes",
    "evidenceField": "evidence"
  }
}